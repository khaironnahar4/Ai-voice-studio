// ═══════════════════════════════════════════════════════════════════════════════
// TTS ENGINE
// Core synthesis request pipeline
// ═══════════════════════════════════════════════════════════════════════════════

/// One row per user TTS submission.
/// Cache hit → servedFromCache = true, no job queued.
/// Cache miss → job queued → worker synthesizes → audioFile created.
///
/// NOTE: Add CHECK constraints via raw SQL after migration:
/// CHECK (speed >= 0.25 AND speed <= 4.0)

model TtsRequest {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  voiceModelId    String        @map("voice_model_id") @db.Uuid

  /// The submitted text
  inputText       String        @map("input_text")

  /// SHA-256(inputText + providerVoiceId + locale + outputFormat + speed)
  /// Used for cache lookups in request_cache
  inputTextHash   String        @map("input_text_hash") @db.VarChar(64)

  /// Character count for quota enforcement
  charCount       Int           @map("char_count")
  wordCount       Int?          @map("word_count")

  status          RequestStatus @default(pending)

  /// Higher = processed sooner. Default 0 = normal.
  priority        Int           @default(0) @db.SmallInt

  /// "mp3" | "wav" | "opus" | "flac"
  outputFormat    String        @default("mp3") @map("output_format") @db.VarChar(10)

  /// BCP-47 locale from the selected voice: "en-US", "bn-BD"
  locale          String?       @db.VarChar(20)

  /// Playback speed: 0.25–4.0. Passed to edge-tts as rate (+25%, -10%)
  speed           Decimal       @default(1.00) @db.Decimal(4, 2)

  /// TRUE if this request was served from request_cache (no synthesis done)
  servedFromCache Boolean       @default(false) @map("served_from_cache")

  /// Provider-specific options (JSONB)
  /// { "voice": "en-US-AvaNeural", "provider": "edge-tts" }
  options         Json?         @default("{}")

  errorMessage    String?       @map("error_message")
  retryCount      Int           @default(0) @map("retry_count") @db.SmallInt
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceModel      VoiceModel    @relation(fields: [voiceModelId], references: [id])
  audioFile       AudioFile?
  jobs            Job[]

  @@index([userId, status])
  @@index([inputTextHash])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("tts_requests")
}

/// Metadata about generated audio files.
/// Binary files live in Supabase Storage.
/// storageKey pattern: audio/{userId}/{YYYY/MM}/{requestId}.mp3
model AudioFile {
  id                 String         @id @default(uuid()) @db.Uuid
  /// One audio file per TTS request
  requestId          String         @unique @map("request_id") @db.Uuid
  /// Denormalized for fast user library queries without JOIN
  userId             String         @map("user_id") @db.Uuid
  storageBucket      String         @map("storage_bucket") @db.VarChar(100)
  /// Object path: audio/{userId}/{YYYY/MM}/{requestId}.mp3
  storageKey         String         @map("storage_key")
  fileName           String         @map("file_name") @db.VarChar(255)
  /// mp3 | wav | ogg | flac
  fileFormat         String         @map("file_format") @db.VarChar(10)
  fileSizeBytes      BigInt         @map("file_size_bytes")
  durationSeconds    Decimal?       @map("duration_seconds") @db.Decimal(8, 3)
  sampleRateHz       Int?           @map("sample_rate_hz")
  bitrateKbps        Int?           @map("bitrate_kbps") @db.SmallInt
  /// CDN-fronted permanent URL (for public files)
  cdnUrl             String?        @map("cdn_url")
  /// Temporary pre-signed download URL (15-min TTL)
  signedUrl          String?        @map("signed_url")
  signedUrlExpiresAt DateTime?      @map("signed_url_expires_at") @db.Timestamptz(6)
  downloadCount      Int            @default(0) @map("download_count")
  isPublic           Boolean        @default(false) @map("is_public")
   checksumSha256   String?   @map("checksum_sha256") @db.VarChar(64)

  /// Edge TTS voice used: "en-US-AvaNeural" — denormalized for audit
  voiceUsed        String?   @map("voice_used") @db.VarChar(200)

  /// Edge TTS locale used: "en-US" — denormalized for audit
  localeUsed       String?   @map("locale_used") @db.VarChar(20)

  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Soft delete — S3 purge happens after 30 days via cleanup job
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  request            TtsRequest     @relation(fields: [requestId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestCaches      RequestCache[]

  @@index([userId], map: "idx_audio_files_user_id")
  @@index([storageKey], map: "idx_audio_files_storage_key")
  @@index([signedUrlExpiresAt], map: "idx_audio_files_signed_url_expires_at")
  @@index([deletedAt], map: "idx_audio_files_deleted_at")
  @@map("audio_files")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JOB QUEUE
// BullMQ audit trail — one DB row per background job
// ═══════════════════════════════════════════════════════════════════════════════

/// Background job tracking table.
/// Complements BullMQ with a durable, queryable audit trail.
/// queueName: "tts.generate" | "tts.export" | "email.send" | "voice.sync"
/// jobType:   "GENERATE_AUDIO" | "SEND_EMAIL" | "SYNC_VOICES" | "REFRESH_SIGNED_URLS"

model Job {
  id           String      @id @default(uuid()) @db.Uuid
  /// Logical queue name: tts.generate | tts.export | email.send
  queueName    String      @map("queue_name") @db.VarChar(100)
  /// Semantic type: GENERATE_AUDIO | SEND_EMAIL | SYNC_VOICES | REFRESH_SIGNED_URLS
  jobType      String      @map("job_type") @db.VarChar(100)
  /// NULL for non-TTS jobs (email, sync, etc.)
  requestId    String?     @map("request_id") @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  /// Input data passed to the worker
  payload      Json        @default("{}")
  status       JobStatus   @default(waiting)
  /// Higher = processed first within the same queue
  priority     Int         @default(0) @db.SmallInt
  attempts     Int         @default(0) @db.SmallInt
  maxAttempts  Int         @default(3) @map("max_attempts") @db.SmallInt
  /// Identity of the worker process handling this job
  workerId     String?     @map("worker_id") @db.VarChar(100)
  startedAt    DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?   @map("completed_at") @db.Timestamptz(6)
  /// For deferred/delayed jobs
  scheduledFor DateTime?   @map("scheduled_for") @db.Timestamptz(6)
  /// Output from worker: { audioFileId: "...", durationMs: 1234 }
  result       Json?
  /// Error details: { message: "...", stack: "...", code: "..." }
  error        Json?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  request      TtsRequest? @relation(fields: [requestId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])

  @@index([queueName, status, priority], map: "idx_jobs_queue_status_priority")
  @@index([requestId], map: "idx_jobs_request_id")
  @@index([userId], map: "idx_jobs_user_id")
  @@index([scheduledFor], map: "idx_jobs_scheduled_for")
  @@index([status, createdAt], map: "idx_jobs_status_created_at")
  @@map("jobs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// RATE LIMITING
// Redis handles hot-path; DB is the audit layer
// ═══════════════════════════════════════════════════════════════════════════════

/// Throttling policy definitions per role or plan.
model RateLimitRule {
  id              Int              @id @default(autoincrement()) @db.SmallInt
  name            String           @db.VarChar(100)
  /// user | role | plan | global
  scope           String           @db.VarChar(50)
  /// The specific role name or plan slug this rule applies to
  scopeId         String?          @map("scope_id")
  /// What is being limited: tts_request | api_call | audio_download
  resource        String           @db.VarChar(100)
  maxRequests     Int              @map("max_requests")
  /// Window duration in seconds: 60 | 3600 | 86400
  windowSeconds   Int              @map("window_seconds")
  /// Extra requests allowed in a burst above maxRequests
  burstAllowance  Int              @default(0) @map("burst_allowance") @db.SmallInt
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rateLimitEvents RateLimitEvent[]

  @@index([scope, scopeId, resource], map: "idx_rate_limit_rules_scope")
  @@map("rate_limit_rules")
}

/// Rolling log of rate-limit window counters per user.
/// Redis handles the hot-path counting; this table is the audit layer.
/// Rows purged after 7 days by scheduled cleanup job.
model RateLimitEvent {
  id           BigInt        @id @default(autoincrement())
  userId       String        @map("user_id") @db.Uuid
  ruleId       Int           @map("rule_id") @db.SmallInt
  resource     String        @db.VarChar(100)
  requestCount Int           @default(1) @map("request_count")
  windowStart  DateTime      @map("window_start") @db.Timestamptz(6)
  windowEnd    DateTime      @map("window_end") @db.Timestamptz(6)
  /// Set when this event caused a 429 response
  blockedAt    DateTime?     @map("blocked_at") @db.Timestamptz(6)
  ipAddress    String?       @map("ip_address") @db.VarChar(45)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  rule         RateLimitRule @relation(fields: [ruleId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ruleId, windowStart], map: "idx_rate_limit_events_user_rule_window")
  @@index([blockedAt], map: "idx_rate_limit_events_blocked_at")
  @@index([createdAt], map: "idx_rate_limit_events_created_at")
  @@map("rate_limit_events")
}

/// SaaS pricing tiers: Free, Pro, Business, Enterprise.
model Plan {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String           @db.VarChar(100)
  slug                 String           @unique @db.VarChar(50)
  description          String?
  /// Monthly price in cents (USD). 0 = free.
  priceMonthly         Int              @default(0) @map("price_monthly_cents")
  /// Annual price in cents
  priceYearly          Int              @default(0) @map("price_yearly_cents")
  /// Monthly character quota. NULL = unlimited.
  charLimitMonthly     BigInt?          @map("char_limit_monthly")
  /// Monthly TTS request cap. NULL = unlimited.
  requestLimitMonthly  Int?             @map("request_limit_monthly")
  /// Audio storage quota in MB. NULL = unlimited.
  storageLimitMb       Int?             @map("storage_limit_mb")
  /// Max audio length per single request in seconds
  maxFileDurationSec   Int?             @map("max_file_duration_sec")
  /// Max parallel background jobs
  concurrentJobs       Int              @default(1) @map("concurrent_jobs") @db.SmallInt
  /// Access to isPremium voice models
  hasPremiumVoices     Boolean          @default(false) @map("has_premium_voices")
  /// Programmatic API access (for developer/enterprise plans)
  hasApiAccess         Boolean          @default(false) @map("has_api_access")
  /// Additional feature flags as JSON
  features             Json?            @default("{}")
  stripeMonthlyPriceId String?          @map("stripe_price_id_monthly") @db.VarChar(255)
  stripeYearlyPriceId  String?          @map("stripe_price_id_yearly") @db.VarChar(255)
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions        Subscription[]
  usageAnalytics       UsageAnalytics[]

  @@index([slug], map: "idx_plans_slug")
  @@index([isActive], map: "idx_plans_is_active")
  @@map("plans")
}

/// User subscription to a plan.
/// NOTE: Enforce one-active-per-user via raw SQL partial unique index:
/// CREATE UNIQUE INDEX uq_subscriptions_user_active
/// ON subscriptions (user_id)
/// WHERE status IN ('active', 'trialing');
model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(active)
  /// monthly | yearly
  billingCycle         String             @default("monthly") @map("billing_cycle") @db.VarChar(10)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(6)
  /// NULL = no trial period
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  metadata             Json?              @default("{}")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoices             Invoice[]
  plan                 Plan               @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_subscriptions_user_id")
  @@index([status], map: "idx_subscriptions_status")
  @@index([stripeSubscriptionId], map: "idx_subscriptions_stripe_id")
  @@map("subscriptions")
}

/// One invoice per billing period per subscription.
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  subscriptionId  String        @map("subscription_id") @db.Uuid
  /// Denormalized for fast user invoice listing
  userId          String        @map("user_id") @db.Uuid
  status          InvoiceStatus @default(draft)
  /// Total amount in cents
  amountCents     Int           @map("amount_cents")
  /// ISO 4217: USD, EUR, etc.
  currency        String        @default("USD") @db.Char(3)
  periodStart     DateTime      @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime      @map("period_end") @db.Timestamptz(6)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  stripeInvoiceId String?       @map("stripe_invoice_id") @db.VarChar(255)
  pdfUrl          String?       @map("pdf_url")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  items           InvoiceItem[]
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_invoices_user_id")
  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([status], map: "idx_invoices_status")
  @@map("invoices")
}

/// Line items within an invoice.
model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  /// "Pro Plan — Monthly", "Character Overage (50k chars)"
  description    String
  quantity       Int      @default(1)
  /// Price per unit in cents
  unitPriceCents Int      @map("unit_price_cents")
  /// quantity × unitPriceCents
  totalCents     Int      @map("total_cents")
  /// plan | overage | addon | credit | tax
  type           String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@map("invoice_items")
}

/// Aggregated daily usage metrics per user.
/// Written by a background summarizer that rolls up tts_requests data.
/// Powers user dashboard and admin analytics.
model UsageAnalytics {
  id                 BigInt   @id @default(autoincrement())
  userId             String   @map("user_id") @db.Uuid
  date               DateTime @db.Date
  /// Plan active on this date (for historical plan tracking)
  planId             String?  @map("plan_id") @db.Uuid
  requestCount       Int      @default(0) @map("request_count")
  completedCount     Int      @default(0) @map("completed_count")
  failedCount        Int      @default(0) @map("failed_count")
  cachedCount        Int      @default(0) @map("cached_count")
  totalChars         BigInt   @default(0) @map("total_chars")
  totalDurationSec   Decimal  @default(0) @map("total_duration_sec") @db.Decimal(12, 3)
  totalFileSizeBytes BigInt   @default(0) @map("total_file_size_bytes")
  apiCalls           Int      @default(0) @map("api_calls")
  rateLimitHits      Int      @default(0) @map("rate_limit_hits")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan               Plan?    @relation(fields: [planId], references: [id])
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], map: "uq_usage_analytics_user_date")
  @@index([userId, date], map: "idx_usage_analytics_user_date")
  @@index([date], map: "idx_usage_analytics_date")
  @@map("usage_analytics")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CACHE
// SHA-256 deduplication — same input → same audio, no re-synthesis
// ═══════════════════════════════════════════════════════════════════════════════

/// TTS result deduplication cache.
/// cache_key = SHA-256(inputText + providerVoiceId + locale + outputFormat + speed)
/// Cache HIT → serve existing AudioFile, zero synthesis cost.
model RequestCache {
  id           String     @id @default(uuid()) @db.Uuid
  /// SHA-256 of the canonical request parameters
  cacheKey     String     @unique @map("cache_key") @db.VarChar(64)
  /// The cached audio output
  audioFileId  String     @map("audio_file_id") @db.Uuid
  voiceModelId String     @map("voice_model_id") @db.Uuid
  /// mp3 | wav | ogg | flac
  outputFormat String     @map("output_format") @db.VarChar(10)
  charCount    Int        @map("char_count")
  /// Total number of times this cache entry was served
  hitCount     Int        @default(0) @map("hit_count")
  lastHitAt    DateTime?  @map("last_hit_at") @db.Timestamptz(6)
  /// NULL = never expires; set for volatile content
  isPinned     Boolean    @default(false) @map("is_pinned")
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  audioFile    AudioFile  @relation(fields: [audioFileId], references: [id])
  voiceModel   VoiceModel @relation(fields: [voiceModelId], references: [id])

  @@index([cacheKey], map: "idx_request_cache_cache_key")
  @@index([expiresAt], map: "idx_request_cache_expires_at")
  @@index([lastHitAt], map: "idx_request_cache_last_hit_at")
  @@map("request_cache")
}

enum RequestStatus {
  pending
  queued
  processing
  completed
  failed
  cancelled

  @@map("request_status")
}

enum JobStatus {
  waiting
  active
  completed
  failed
  delayed
  cancelled

  @@map("job_status")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible

  @@map("invoice_status")
}
