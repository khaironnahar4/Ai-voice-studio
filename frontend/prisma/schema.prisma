generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at")
  role            String?
  banned          Boolean?
  banReason       String?          @map("ban_reason")
  banExpires      DateTime?        @map("ban_expires")
  accounts        Account[]
  audioFiles      AudioFile[]
  invoices        Invoice[]
  jobs            Job[]
  rateLimitEvents RateLimitEvent[]
  sessions        Session[]
  subscriptions   Subscription[]
  ttsRequests     TtsRequest[]
  usageAnalytics  UsageAnalytics[]

  @@map("user")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  expiresAt     DateTime @map("expires_at")
  token         String   @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  userId        String   @map("user_id") @db.Uuid
  impersonateBy String?  @map("impersonate_by")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOICE CATALOG
// Microsoft Edge TTS voice library
// Synced via edge-tts list_voices() — 400+ voices available
// ═══════════════════════════════════════════════════════════════════════════════

/// Supported speech synthesis languages (BCP-47 codes).
/// Seeded at migration. Updated when new languages are added to Edge TTS.
model Language {
  id         Int          @id @default(autoincrement()) @db.SmallInt
  code       String       @unique @db.VarChar(20)   // "en-US", "bn-BD", "fr-FR"
  name       String       @db.VarChar(100)           // "English (United States)"
  nativeName String?      @map("native_name") @db.VarChar(100)
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  voiceModels VoiceModel[]

  @@index([code])
  @@index([isActive])
  @@map("languages")
}

/// Microsoft Edge TTS voice catalog.
/// Synced from edge-tts list_voices() via /api/admin/sync-voices.
/// Each row = one Edge TTS Neural voice.
model VoiceModel {
  id             String   @id @default(uuid()) @db.Uuid
  languageId     Int      @map("language_id") @db.SmallInt

  /// Display name shown in UI: "Ava", "Andrew", "Sonia"
  name           String   @db.VarChar(100)

  /// URL-safe unique identifier: "en-us-avaneural"
  slug           String   @unique @db.VarChar(120)

  /// Always "edge-tts" — kept for future multi-provider support
  provider       String   @default("edge-tts") @db.VarChar(50)

  /// Full Edge TTS short name used in API calls: "en-US-AvaNeural"
  providerVoiceId String  @unique @map("provider_voice_id") @db.VarChar(200)

  /// "Female" | "Male"
  gender         String?  @db.VarChar(20)

  /// Accent extracted from locale: "american", "british", "australian"
  accent         String?  @db.VarChar(50)

  /// BCP-47 locale string: "en-US", "bn-BD", "fr-FR"
  locale String @default("en-US") @db.VarChar(20)

  /// e.g. ["conversational", "newscast", "customerservice", "narration"]
  styleTags      String[] @map("style_tags")

  /// Microsoft full voice name: "Microsoft Server Speech Text to Speech Voice (en-US, AvaNeural)"
  fullName       String?  @map("full_name")

  /// Codec suggested by Edge TTS: "audio-24khz-48kbitrate-mono-mp3"
  suggestedCodec String?  @map("suggested_codec") @db.VarChar(100)

  /// Human-friendly name from Edge TTS: "Microsoft Ava Online (Natural) - English (United States)"
  friendlyName   String?  @map("friendly_name")

  /// "GA" | "Preview" — GA voices are stable
  voiceStatus    String   @default("GA") @map("voice_status") @db.VarChar(20)

  /// Hosted preview audio URL (optional — for UI preview playback)
  previewUrl     String?  @map("preview_url")

  /// Restricted to paid plans only
  isPremium      Boolean  @default(false) @map("is_premium")

  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order") @db.SmallInt
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  language       Language       @relation(fields: [languageId], references: [id])
  ttsRequests    TtsRequest[]
  requestCaches  RequestCache[]

  @@index([languageId])
  @@index([isActive])
  @@index([locale])
  @@index([gender])
  @@index([providerVoiceId])
  @@map("voice_models")
}


/// Audit log for every voice sync operation.
/// Triggered by admin sync job or cron.
model VoiceSyncLog {
  id                String    @id @default(uuid()) @db.Uuid

  /// "full" | "incremental"
  syncType          String    @map("sync_type") @db.VarChar(30)

  /// "running" | "completed" | "failed"
  status            String    @db.VarChar(20)

  voicesFetched     Int       @default(0) @map("voices_fetched")
  voicesAdded       Int       @default(0) @map("voices_added")
  voicesUpdated     Int       @default(0) @map("voices_updated")
  voicesDeactivated Int       @default(0) @map("voices_deactivated")
  durationMs        Int?      @map("duration_ms")
  errorMessage      String?   @map("error_message")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@index([status])
  @@map("voice_sync_log")
}

