// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  role          String?
  banned        Boolean? 
  banReason     String?
  banExpires    DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonateBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// ELEVENLABS — API SYNC TABLES
// ============================================================

/// Mirrors ElevenLabs model catalog.
/// Synced daily via GET /v1/models.
model ElSpeechModel {
  id                      String    @id @default(uuid()) @db.Uuid

  /// ElevenLabs model string: eleven_v3, eleven_flash_v2_5, eleven_multilingual_v2
  elModelId               String    @unique @map("el_model_id") @db.VarChar(100)

  name                    String    @db.VarChar(150)
  description             String?   @db.Text
  canDoTts                Boolean   @default(true) @map("can_do_tts")

  /// ISO 639-1 language codes this model supports
  supportedLanguages      String[]  @map("supported_languages") @db.Text

  /// Character limit per single request: 5000 (v3), 10000 (v2), 40000 (flash)
  maxCharactersPerRequest Int       @map("max_characters_per_request")

  /// True for Flash models (~75ms latency)
  isFlash                 Boolean   @default(false) @map("is_flash")

  /// True for deprecated models (monolingual_v1, turbo_v2)
  isDeprecated            Boolean   @default(false) @map("is_deprecated")
  isActive                Boolean   @default(true) @map("is_active")

  /// Relative cost factor from EL pricing
  tokenCostFactor         Decimal?  @map("token_cost_factor") @db.Decimal(5, 4)

  lastSyncedAt            DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz


  @@index([elModelId],    map: "idx_el_speech_models_el_model_id")
  @@index([isActive],     map: "idx_el_speech_models_is_active")
  @@map("el_speech_models")
}

/// Periodic snapshots of ElevenLabs character usage.
/// Synced hourly via GET /v1/user/subscription.
/// Append-only — no updates, all rows kept for trend analysis.
model ElUsageSync {
  id                        BigInt    @id @default(autoincrement())
  charactersUsed            BigInt    @map("characters_used")
  characterLimit            BigInt    @map("character_limit")

  /// character_limit - characters_used (computed before insert)
  charactersRemaining       BigInt    @map("characters_remaining")

  voiceLimit                Int?      @map("voice_limit")
  professionalVoiceLimit    Int?      @map("professional_voice_limit")
  canExtendCharacterLimit   Boolean   @default(false) @map("can_extend_character_limit")
  canUseInstantVoiceCloning Boolean   @default(false) @map("can_use_instant_voice_cloning")

  /// EL plan tier name: free, starter, creator, pro, enterprise
  elPlanTier                String?   @map("el_plan_tier") @db.VarChar(50)

  nextCharacterResetAt      DateTime? @map("next_character_reset_at") @db.Timestamptz

  /// Full raw EL API response for debugging
  rawResponse               Json?     @map("raw_response")

  syncedAt                  DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  @@index([syncedAt], map: "idx_el_usage_sync_synced_at")
  @@map("el_usage_sync")
}


/// Audit log for every voice library sync operation.
model ElVoiceSyncLog {
  id                String    @id @default(uuid()) @db.Uuid

  /// full | incremental | single_voice
  syncType          String    @map("sync_type") @db.VarChar(30)

  /// running | completed | failed | partial
  status            String    @db.VarChar(20)

  voicesFetched     Int       @default(0) @map("voices_fetched")
  voicesAdded       Int       @default(0) @map("voices_added")
  voicesUpdated     Int       @default(0) @map("voices_updated")
  voicesDeactivated Int       @default(0) @map("voices_deactivated")
  pagesFetched      Int       @default(0) @map("pages_fetched") @db.SmallInt
  durationMs        Int?      @map("duration_ms")
  errorMessage      String?   @map("error_message") @db.Text
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz

  @@index([startedAt], map: "idx_el_voice_sync_log_started_at")
  @@index([status],    map: "idx_el_voice_sync_log_status")
  @@map("el_voice_sync_log")
}


// ============================================================
// VOICE CATALOG
// ============================================================

/// Supported speech synthesis languages (BCP-47 codes).
/// Seeded at migration; updated when new languages are added to EL.
model Language {
  id         Int      @id @default(autoincrement()) @db.SmallInt
  code       String   @unique @db.VarChar(10)
  name       String   @db.VarChar(100)
  nativeName String?  @map("native_name") @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ── Relations ──────────────────────────────
  // voiceModels VoiceModel[]

  @@index([code],     map: "idx_languages_code")
  @@index([isActive], map: "idx_languages_is_active")
  @@map("languages")
}